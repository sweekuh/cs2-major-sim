# swiss-mc — optional live-odds provider keys (DX-05)
#
# The app runs RATING-ONLY without any of these — the first sim needs NO API key and shows a
# `live odds off (no ODDSPAPI_KEY) — using manual ratings` banner (fail-soft, never crashes).
# These keys are Phase-5 / v1+ enhancements that back-solve per-team ratings from market odds.
#
# Copy this file to `.env` and fill in the values you have. `.env` is gitignored — NEVER
# commit real keys. Leave any provider blank to keep it off.

# OddsPapi (Pinnacle-backed esports odds) — the primary provider.
ODDSPAPI_KEY=

# Polymarket (prediction-market odds) — optional.
POLYMARKET_API_KEY=

# Kalshi (regulated event contracts) — optional.
KALSHI_API_KEY=
